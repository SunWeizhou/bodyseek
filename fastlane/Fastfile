# fastlane 发布骨架（审计 H5 发布链路；未验证——需 Apple 开发者账号后执行）
#
# 用法：
#   1) bundle install                 # 安装 fastlane（仓库首次）
#   2) bundle exec fastlane beta      # 构建 → 上传 TestFlight
#
# 账号信息通过环境变量提供（不要写入仓库）：
#   APP_STORE_CONNECT_API_KEY_PATH  （App Store Connect API Key 的 .p8 路径）
#   APP_STORE_CONNECT_ISSUER_ID
#   APP_STORE_CONNECT_KEY_ID
#   FASTLANE_TEAM_ID
#
# 说明：beta lane 使用 Release 配置归档，并在上传前注入、校验构建号与
# 发布签名（不允许 get-task-allow）。首次需在 App Store Connect 完成协议/税务
# 并创建 App 记录。

default_platform(:ios)

platform :ios do
  desc "构建并上传 TestFlight（Release + 注入并校验构建号）"
  lane :beta do
    build_number = ENV["BUILD_NUMBER"] ||
      Time.now.utc.strftime("%Y%m%d%H%M").to_i.to_s
    UI.user_error!("BUILD_NUMBER 必须是正整数：#{build_number}") unless build_number.match?(/\A[1-9][0-9]*\z/)
    marketing_version = ENV["MARKETING_VERSION"] || "4.0.0"
    derived_data = File.expand_path("~/Developer/Vela-DerivedData")

    api_key = app_store_connect_api_key(
      key_id: ENV.fetch("APP_STORE_CONNECT_KEY_ID"),
      issuer_id: ENV.fetch("APP_STORE_CONNECT_ISSUER_ID"),
      key_filepath: ENV.fetch("APP_STORE_CONNECT_API_KEY_PATH"),
      duration: 1200
    )

    build_app(
      scheme: "Vela",
      configuration: "Release",
      derived_data_path: derived_data,
      export_method: "app-store",
      skip_package_dependencies: false,
      xcargs: {
        "CODE_SIGN_STYLE" => "Automatic",
        "CURRENT_PROJECT_VERSION" => build_number,
        "MARKETING_VERSION" => marketing_version
      }
    )

    # 校验导出的 IPA，而不是未导出的 Release-iphoneos 中间产物：
    # 后者在自动签名阶段可能仍带 development entitlement，导出 app-store 后才会重签。
    ipa_path = lane_context[SharedValues::IPA_OUTPUT_PATH]
    UI.user_error!("未找到导出的 IPA 产物") unless ipa_path && File.exist?(ipa_path)
    verify_dir = "/tmp/vela-testflight-verify"
    sh("rm -rf '#{verify_dir}' && mkdir -p '#{verify_dir}' && unzip -q '#{ipa_path}' -d '#{verify_dir}'")
    app_path = "#{verify_dir}/Payload/Vela.app"
    UI.user_error!("IPA 内缺少 Vela.app") unless File.exist?("#{app_path}/Info.plist")
    actual_build = sh("/usr/libexec/PlistBuddy -c 'Print :CFBundleVersion' '#{app_path}/Info.plist'").strip
    UI.user_error!("构建号未注入：期望 #{build_number}，实际 #{actual_build}") unless actual_build == build_number
    actual_marketing = sh("/usr/libexec/PlistBuddy -c 'Print :CFBundleShortVersionString' '#{app_path}/Info.plist'").strip
    UI.user_error!("版本号不匹配：期望 #{marketing_version}，实际 #{actual_marketing}") unless actual_marketing == marketing_version
    entitlements = sh("codesign -d --entitlements :- '#{app_path}' 2>&1")
    UI.user_error!("导出的 IPA 仍带 get-task-allow，不能上传 TestFlight") if entitlements.include?("get-task-allow")

    pilot(
      app_identifier: "com.sunweizhou.Vela4",
      api_key: api_key,
      skip_submission: false,
      distribute_external: false,
      groups: [] # 首次需要先在 TestFlight 添加外部测试组
    )

    slack(
      message: "Vela TestFlight 构建已上传 🚀",
      default_payloads: [:git_branch, :git_commit]
    ) if ENV.key?("SLACK_WEBHOOK_URL")
  end

  desc "为真机打 Debug 包"
  lane :device do
    build_app(
      scheme: "Vela",
      configuration: "Debug",
      derived_data_path: "~/Developer/Vela-DerivedData",
      export_method: "development"
    )
  end
end
